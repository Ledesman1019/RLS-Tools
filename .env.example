# RLS Tools usa la MISMA base de datos del ERP HANA4 (mismos usuarios, roles y stock).
# Copia este archivo como .env.local con los mismos valores del ERP.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección del ERP (botón «Abrir el ERP»)
NEXT_PUBLIC_ERP_URL=https://hana-4.vercel.app

# No se necesita la clave de servicio: todo pasa por RLS y por las funciones del ERP.
